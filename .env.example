NODE_ENV=development
PORT=4000
MONGODB_URI=
# Comma-separated exact origins, e.g. https://hassan.example.com,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
# Each at least 32 random characters. REFRESH secret is used to HMAC refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# lax | strict | none (none requires HTTPS; use when frontend and API are on different sites)
COOKIE_SAMESITE=lax
UPLOAD_DIR=uploads
# SMTP credentials stay on the server. Use port 465 with SMTP_SECURE=true, otherwise usually 587.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_OWNER_EMAIL=
# Used only by `npm run admin:init`
ADMIN_EMAIL=
ADMIN_PASSWORD=
