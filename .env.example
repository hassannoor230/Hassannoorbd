NODE_ENV=development
PORT=4000
MONGODB_URI=
# Comma-separated exact origins, e.g. https://hassan.example.com,http://localhost:3000
CLIENT_ORIGIN=http://localhost:3000
# Each at least 32 random characters. REFRESH secret is used to HMAC refresh tokens.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# lax | strict | none (none requires HTTPS; use when frontend and API are on different sites)
COOKIE_SAMESITE=lax
UPLOAD_DIR=uploads
# Used only by `npm run admin:init`
ADMIN_EMAIL=
ADMIN_PASSWORD=
